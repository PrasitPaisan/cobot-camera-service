# DEBUG shows every PLC poll read/write and every detection box; INFO
# (default) shows only state transitions and results.
LOG_LEVEL=INFO

CAMERA_IP=192.168.3.100
CAMERA_NET_IP=192.168.3.1
CAMERA_GET_FRAME_TIMEOUT_MS=1000
CAMERA_RECONNECT_SECONDS=3
CAMERA_MAX_CONSECUTIVE_ERRORS=10

# Off / Once / Continuous -- same feature MVS's one-click brightness button
# uses. Continuous fixes the camera opening dark on first connect.
CAMERA_EXPOSURE_AUTO=Continuous
CAMERA_GAIN_AUTO=Continuous

# How long to free-run on connect before switching into trigger mode, so
# ExposureAuto/GainAuto=Continuous has real frames to converge against first.
CAMERA_BRIGHTNESS_WARMUP_SECONDS=8.0

# If a triggered frame's mean pixel value falls below this (0-255 scale) for
# this many triggers in a row, the camera automatically re-runs the
# brightness warmup -- recovers on its own from a lighting glitch mid-run
# instead of staying dark until someone restarts the service.
CAMERA_DARK_FRAME_THRESHOLD=40.0
CAMERA_DARK_FRAME_MAX_CONSECUTIVE=1

# Upper bound (symmetric to the dark check above) -- catches the light
# coming back ON after an outage, where the high exposure/gain left over
# from compensating for the dark makes frames blow out/overexpose instead.
CAMERA_BRIGHT_FRAME_THRESHOLD=180.0

# Warmup used only for the mid-run recalibration above -- it blocks the
# next PLC trigger, so it's a real production-line cost, but with
# CAMERA_DARK_FRAME_MAX_CONSECUTIVE=1 this is the only shot it gets to
# converge before the next real ampoule is judged on the result.
CAMERA_RECALIBRATE_WARMUP_SECONDS=10.0

# Same PLC backend_fast talks to, but on its own dedicated port (5001) -- a
# separate connection slot from backend_fast's PLC_READ_PORT/PLC_WRITE_PORT
# (5000/4999), since the PLC's Ethernet module only tolerates a handful of
# simultaneous connections. Used for reading CAM_TRIG_DEVICE.
PLC_HOST=192.168.3.250
PLC_PORT=5001
CAM_TRIG_DEVICE=M6000
PLC_TRIGGER_POLL_SECONDS=0.5
PLC_RECONNECT_SECONDS=3

# pymcprotocol's own default socket timeout is a hardcoded 2 seconds -- too
# tight on some production networks. Raise if PLC connects keep timing out
# even though the port is reachable (confirmed via Test-NetConnection).
PLC_SOCKET_TIMEOUT_SECONDS=5.0

# Same cobot idle/busy bits backend_fast polls -- gates the trigger poll
# speed: slow (PLC_IDLE_POLL_SECONDS) while the cobot isn't running, fast
# (PLC_TRIGGER_POLL_SECONDS) only for the duration of a running cycle.
RUNNING_DEVICE=M286
READY_DEVICE=M287
PLC_IDLE_POLL_SECONDS=5

# Wait this long after the trigger edge before taking the snapshot, so motion/
# vibration has settled and the saved image isn't blurry.
CAMERA_TRIGGER_SETTLE_SECONDS=0.5

# Full-resolution frame saved (relative to the working directory, unless
# given as an absolute path) on every PLC trigger, sorted into OK/NG
# subfolders by the judgment made -- OK saves the annotated (boxed) copy, NG
# saves the plain frame.
TRAINING_DATA_DIR=adddata

# YOLO model used to judge each trigger snapshot -- ampoule detected
# at/above this confidence counts as OK, otherwise NG.
VISION_MODEL_PATH=best.pt
VISION_CONF_THRESHOLD=0.25

# Result bits pulsed back to the PLC (1 -> hold -> 0) after each trigger
# snapshot is judged. MUST match the devices actually wired in the PLC
# program -- these are placeholders, confirm the real addresses before
# running against production hardware.
CAM_RESULT_OK_DEVICE=M5000
CAM_RESULT_NG_DEVICE=M5001
CAM_RESULT_HOLD_SECONDS=0.5
